{
  "manifest_version": 3,
  "name": "Said Screenshot Pro",
  "version": "1.0.0",
  "description": "Professional Chrome Extension for high-resolution visible area, area selection, scrolling full-page capture, annotation editor, PDF export, and Google Drive backup.",
  "author": "Said",
  "permissions": [
    "activeTab",
    "storage",
    "downloads",
    "contextMenus",
    "scripting",
    "identity"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Said Screenshot Pro",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+E",
        "mac": "Command+Shift+E"
      },
      "description": "Open Said Screenshot Pro Popup"
    },
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Capture Visible Area Screenshot"
    },
    "capture-area": {
      "suggested_key": {
        "default": "Ctrl+Shift+A",
        "mac": "Command+Shift+A"
      },
      "description": "Select Area Screenshot"
    },
    "capture-fullpage": {
      "suggested_key": {
        "default": "Ctrl+Shift+F",
        "mac": "Command+Shift+F"
      },
      "description": "Full Page Scrolling Screenshot"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "icons/*"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}